# NOVA runtime
NOVA_ENV=development
NOVA_HOST=127.0.0.1
NOVA_PORT=8742
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Brain providers. Ollama is the local-first default.
LLM_PROVIDER=ollama
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
# Explicit hybrid tag: the moving qwen3:4b tag can be Thinking-only.
OLLAMA_MODEL=qwen3:4b-q4_K_M
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
LLM_ROUTING_POLICY=local_first
GEMINI_ENABLED=true
GEMINI_API_KEY=
# Leave blank to use the first live-confirmed model in this allowlist.
GEMINI_MODEL=
# Exact IDs from Google's published Free Tier pricing; live discovery must
# confirm each ID before NOVA can select it. Update when Google changes pricing.
GEMINI_FREE_MODEL_ALLOWLIST=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
MODEL_ROUTING_MODE=BALANCED
FREE_ONLY=true
ZERO_BUDGET_MODE=true
STRICT_LOCAL=false
PRIVACY_MODE=LOCAL_FIRST
JURY_MODE=false
PREFERRED_LOCAL_MODEL=
PREFERRED_CLOUD_MODEL=
LLM_REQUEST_TIMEOUT=60
LLM_MAX_TOKENS=512
LLM_SIMPLE_MAX_TOKENS=256
LLM_COMPLEX_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_THINKING_MODE=smart
LLM_THINKING_DEFAULT=false
CONVERSATION_HISTORY_LIMIT=12
LLM_VERBOSE_LOGGING=false

# Storage
DATABASE_PATH=backend/data/nova.db

# Voice and privacy defaults
VOICE_ENABLED=true
VOICE_NAME=Samantha
VOICE_SPEED=185
STT_ENABLED=true
TTS_ENABLED=true
WHISPER_PROVIDER=local
WHISPER_MODEL=small
# Leave blank to use backend/data/models/ggml-<model>.bin
WHISPER_MODEL_PATH=
WHISPER_BINARY=whisper-cli
WHISPER_LANGUAGE=auto
STT_TIMEOUT=120
TTS_PROVIDER=macos
# Legacy voice preference: only honored when its locale matches the answer.
TTS_VOICE=
# Blank voice names discover installed voices; never use an unknown OS default.
TTS_LANGUAGE_MODE=auto
TTS_VOICE_ENGLISH=
TTS_VOICE_HINDI=
TTS_VOICE_FALLBACK=
TTS_RATE=180
VOICE_AUTO_STOP=false
VOICE_SILENCE_TIMEOUT_MS=1200
VOICE_MAX_RECORDING_SECONDS=60
VOICE_SHORTCUT=Alt+Space
WAKE_WORD_ENABLED=false
WAKE_WHISPER_MODEL=tiny
WAKE_MODEL_PATH=
CONVERSATION_FOLLOWUP_WINDOW_SECONDS=10
MICROPHONE_DEVICE=
AUTO_GAIN=true
PRE_ROLL_MS=350
POST_ROLL_MS=250
SCREEN_CONTEXT_ENABLED=false
MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACTION=true
MEMORY_MIN_CONFIDENCE=0.75
MEMORY_TOP_K=5
SAVE_CHAT_HISTORY=true

# Computer tasks: real mode is explicitly enabled from Computer settings.
COMPUTER_USE_ENABLED=false
COMPUTER_USE_SIMULATION=true
COMPUTER_AGENT_MODE=SEMI_AUTONOMOUS
COMPUTER_SCREEN_ACCESS=false
COMPUTER_ACCESSIBILITY_ACCESS=false
COMPUTER_BROWSER_ACCESS=true
COMPUTER_FILESYSTEM_ACCESS=true
COMPUTER_TERMINAL_ACCESS=false
COMPUTER_VISION_ENABLED=true
COMPUTER_REQUIRE_CONFIRMATION=false
COMPUTER_ALLOW_CLOUD_PLANNING=false
TASK_TIMEOUT_SECONDS=300
MAX_TASK_STEPS=24
COMMAND_LOGGING_ENABLED=true

# Independent upgrade flags; native builds set NATIVE_APP_ENABLED themselves.
NATIVE_APP_ENABLED=false
LIVE_TASK_VIEW_ENABLED=false
VISION_ENABLED=true
CONNECTORS_ENABLED=false
MCP_ENABLED=false
# Google OAuth is optional and backend-only. The redirect must be registered
# in the Google Cloud OAuth client before enabling the connector.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8742/api/connectors/google/callback
# Add calendar.readonly and drive.readonly only when those read features are
# needed; changing scopes requires reconnecting the Google account.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly
# GitHub OAuth is optional and backend-only. Register the redirect URI before
# enabling the connector. Read tools only are exposed by the first adapter.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8742/api/connectors/github/callback
GITHUB_OAUTH_SCOPES=read:user public_repo
# Official Notion internal integration token; never send this to the frontend.
NOTION_API_TOKEN=
NOTION_VERSION=2022-06-28

# Frontend can override this when the backend is hosted elsewhere.
# VITE_API_BASE_URL=http://127.0.0.1:8742
